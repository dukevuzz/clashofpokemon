# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Long and random. Postgres is never published to the host, but this is the
# only thing between the api and the database if that ever changes.
DB_PASSWORD=

# Shared by the api and the game server, and the only thing stopping anything
# else posting fake match results. They once read two different property
# names and every result was silently discarded, so it is one name now.
INTERNAL_KEY=

# The names Caddy gets certificates for. Both must already resolve to this
# machine, or the certificate challenge fails and Caddy retries in a loop.
GAME_HOST=game.clashofpokemon.online
API_HOST=api.clashofpokemon.online

# Where the images come from. Built in CI and pulled here, so the box never
# compiles -- a Maven build on two cores would compete with the match loop,
# which has 33ms to finish every frame.
REGISTRY=ducvu123
TAG=latest
