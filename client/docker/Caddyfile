:8080 {
	root * /srv
	encode gzip
	# Hashed filenames, so they can be cached hard. The atlases are the bulk
	# of the download and never change without changing name.
	@immutable path *.js *.css *.png *.webp *.json
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}
