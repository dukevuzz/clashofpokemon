{
  "name": "clashofpokemon",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "check:self": "tsx tools/selfcheck.ts",
    "check:browser": "cp tools/browsercheck.js dist/ && echo 'now: npm run preview, then in the browser console:  eval(await (await fetch(\"/browsercheck.js\")).text())'",
    "check:all": "tsc --noEmit && vitest run && tsx tools/selfcheck.ts",
    "sim": "tsx tools/simulate.ts",
    "actions": "tsx tools/actions.ts",
    "export:content": "tsx tools/export-content.ts",
    "export:fixtures": "tsx tools/export-fixtures.ts",
    "export:differential": "tsx tools/export-differential.ts",
    "export:wire": "tsx tools/export-wire.ts",
    "export:events": "tsx tools/export-events.ts",
    "export:contract": "tsx tools/export-contract.ts",
    "export:portraits": "tsx tools/export-portraits.ts",
    "audit": "tsx tools/audit.ts",
    "coverage": "vitest run --coverage --coverage.include=src/core/** --coverage.include=src/net/** --coverage.include=src/ui/deckStore.ts",
    "candidates": "tsx tools/candidates.ts",
    "balance:snapshot": "tsx tools/balance-diff.ts snapshot",
    "balance:diff": "tsx tools/balance-diff.ts diff",
    "breakpoints": "tsx tools/breakpoints.ts",
    "pick": "tsx tools/pick-roster.ts",
    "chains": "tsx tools/all-chains.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "phaser": "^3.87.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
